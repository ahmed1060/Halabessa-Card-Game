rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // avatar_picker.dart uploads to avatars/<uid>.jpg -- only the owner may
    // write their own file, matched by comparing the full filename (the
    // upload code bakes the uid straight into the name, no separate uid
    // segment) against auth.uid + '.jpg'.
    match /avatars/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && fileName == request.auth.uid + '.jpg';
    }

    // admin_add_item_dialog.dart uploads store item art here; the screen is
    // reached only from admin UI, and the write is now actually enforced
    // server-side by the custom-claim check rather than just client gating.
    match /store_items/{type}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
