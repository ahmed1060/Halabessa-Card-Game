{
  "rules": {
    "matches": {
      "$matchId": {
        ".read": "auth != null",
        ".write": "auth != null && data.exists() && data.child('players').hasChild(auth.uid)"
      }
    },
    "matchHands": {
      "$matchId": {
        ".read": "auth != null && root.child('matches').child($matchId).child('players').hasChild(auth.uid)",
        ".write": "auth != null && root.child('matches').child($matchId).child('players').hasChild(auth.uid)"
      }
    },
    "matchSecrets": {
      "$matchId": {
        ".read": false,
        ".write": false
      }
    },
    "matchmaking_queue": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": false
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid && newData.child('friendInvites').val() == data.child('friendInvites').val()",
        "friendInvites": {
          ".write": false
        }
      }
    }
  }
}
