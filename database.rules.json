{
  "rules": {
  "accountDeletionBlocked": {
    ".read": false,
    ".write": false
  },
  "matchChat": {
    "$matchId": {
      "public": {
        ".indexOn": [
          "senderId",
          "timestamp"
        ],
        ".read": "auth != null && !root.child('accountDeletionBlocked').child(auth.uid).exists() && root.child('matches').child($matchId).child('protocolVersion').val() == 1 && root.child('matches').child($matchId).child('players').hasChild(auth.uid)",
        "$messageId": {
          ".write": false,
          "id": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "senderId": {
            ".validate": "newData.isString()"
          },
          "senderName": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300"
          },
          "timestamp": {
            ".validate": "newData.isNumber() && newData.val() == now"
          },
          "isQuickChat": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          },
          "presetId": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          }
        }
      },
      "teamA": {
        ".read": false,
        ".write": false
      },
      "teamB": {
        ".read": false,
        ".write": false
      },
      "rate": {
        ".read": false,
        ".write": false
      }
    }
  },
  "quickChatPresets": {".read": false, ".write": false},
    "userPresence": {
      "$uid": {
        ".read": "auth != null && !root.child('accountDeletionBlocked').child(auth.uid).exists()",
        "$connection": {
          ".write": "auth != null && !root.child('accountDeletionBlocked').child(auth.uid).exists() && auth.uid == $uid",
          ".validate": "newData.hasChildren(['lastSeen'])",
          "lastSeen": { ".validate": "newData.isNumber() && newData.val() == now" },
          "$other": { ".validate": false }
        }
      }
    },
    "matches": {
      "$matchId": {
        ".read": "auth != null && !root.child('accountDeletionBlocked').child(auth.uid).exists()",
        ".write": "auth != null && !root.child('accountDeletionBlocked').child(auth.uid).exists() && data.exists() && data.child('players').hasChild(auth.uid) && (!data.child('protocolVersion').exists() || data.child('protocolVersion').val() == 0) && (!newData.child('protocolVersion').exists() || newData.child('protocolVersion').val() == 0) && (!newData.child('chat').exists() || newData.child('chat').val() == data.child('chat').val())",
        "presence": {
          "$uid": {
            ".write": "auth != null && !root.child('accountDeletionBlocked').child(auth.uid).exists() && auth.uid == $uid && root.child('matches').child($matchId).child('protocolVersion').val() == 1 && root.child('matches').child($matchId).child('players').hasChild(auth.uid) && (!newData.exists() || newData.val() == true)"
          }
        },
        "playerLastActive": {
          "$uid": {
            ".write": "auth != null && !root.child('accountDeletionBlocked').child(auth.uid).exists() && auth.uid == $uid && root.child('matches').child($matchId).child('protocolVersion').val() == 1 && root.child('matches').child($matchId).child('players').hasChild(auth.uid) && (!newData.exists() || (newData.isString() && newData.val().length <= 40))"
          }
        },
        "chat": {
          ".indexOn": ["senderId"],
          "$messageId": {
            ".write": false,
            "id": { ".validate": true },
            "senderId": { ".validate": true },
            "senderName": { ".validate": true },
            "text": { ".validate": true },
            "timestamp": { ".validate": true },
            "isQuickChat": { ".validate": true },
            "$other": { ".validate": "root.child('matches').child($matchId).child('protocolVersion').val() != 1" }
          }
        }
      }
    },
    "matchHands": {
      "$matchId": {
        ".read": "auth != null && !root.child('accountDeletionBlocked').child(auth.uid).exists() && root.child('matches').child($matchId).child('players').hasChild(auth.uid) && (!root.child('matches').child($matchId).child('protocolVersion').exists() || root.child('matches').child($matchId).child('protocolVersion').val() == 0)",
        ".write": "auth != null && !root.child('accountDeletionBlocked').child(auth.uid).exists() && root.child('matches').child($matchId).child('players').hasChild(auth.uid) && (!root.child('matches').child($matchId).child('protocolVersion').exists() || root.child('matches').child($matchId).child('protocolVersion').val() == 0)",
        "$uid": {
          ".read": "auth != null && !root.child('accountDeletionBlocked').child(auth.uid).exists() && auth.uid == $uid && root.child('matches').child($matchId).child('protocolVersion').val() == 1 && root.child('matches').child($matchId).child('players').hasChild(auth.uid)"
        }
      }
    },
    "matchViews": {
      "$matchId": {
        "$uid": {
          ".read": "auth != null && !root.child('accountDeletionBlocked').child(auth.uid).exists() && auth.uid === $uid && root.child('matches').child($matchId).child('protocolVersion').val() === 1 && root.child('matches').child($matchId).child('players').hasChild(auth.uid)",
          ".write": false
        }
      }
    },
    "matchSecrets": {
      "$matchId": {
        ".read": false,
        ".write": false
      }
    },
    "matchmaking_queue": {
      ".read": "auth != null && !root.child('accountDeletionBlocked').child(auth.uid).exists()",
      "$uid": {
        ".write": "auth != null && !root.child('accountDeletionBlocked').child(auth.uid).exists() && auth.uid == $uid"
      }
    },
    "rooms": {
      ".indexOn": ["isPublic"],
      ".read": "auth != null && !root.child('accountDeletionBlocked').child(auth.uid).exists()",
      "$roomId": {
        ".write": false
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && !root.child('accountDeletionBlocked').child(auth.uid).exists() && (auth.uid == $uid || auth.token.admin == true)",
        ".write": "auth != null && !root.child('accountDeletionBlocked').child(auth.uid).exists() && auth.uid == $uid && newData.child('friendInvites').val() == data.child('friendInvites').val()",
        "friendInvites": {
          ".write": false
        }
      }
    }
  }
}
