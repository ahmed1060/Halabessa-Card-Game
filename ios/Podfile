# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = '1'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  # Current Flutter CI actions export this directly. Newer Flutter SDKs no
  # longer guarantee that Generated.xcconfig contains FLUTTER_ROOT.
  environment_flutter_root = ENV['FLUTTER_ROOT']
  return environment_flutter_root unless environment_flutter_root.nil? || environment_flutter_root.empty?

  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "Generated.xcconfig must exist. If you're running pod install manually, make sure flutter pub get has been executed."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/\AFLUTTER_ROOT=(.*)\z/)
    return matches[1] if matches
  end
  raise "FLUTTER_ROOT not found in Generated.xcconfig. Try deleting Generated.xcconfig and running flutter pub get."
end

# Generated.xcconfig exposes FLUTTER_ROOT; podhelper supplies the Flutter
# CocoaPods integration methods used below. The export-environment script is
# not a Ruby file and must not be required by CocoaPods.
require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

install! 'cocoapods', :deterministic_uuids => false

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # CocoaPods applies the plugin's xcconfig to its generated privacy bundle
    # target as well as to the plugin framework.  That xcconfig links
    # UnityFramework, whose stale Unity export still has Firebase SPM
    # dependencies. Xcode consequently treats every transitive Firebase
    # resource bundle as a resource of flutter_unity_widget_privacy and tries
    # to copy those products before they exist. This target contains only the
    # privacy manifest and must not link frameworks.
    if target.name == 'flutter_unity_widget-flutter_unity_widget_privacy'
      target.build_configurations.each do |config|
        config.build_settings['OTHER_LDFLAGS'] = ''
        config.build_settings['FRAMEWORK_SEARCH_PATHS'] = '$(inherited)'
      end
    end
    
    # Help the plugin find UnityFramework
    if target.name == 'flutter_unity_widget'
      target.build_configurations.each do |config|
        config.build_settings['FRAMEWORK_SEARCH_PATHS'] ||= '$(inherited)'
        config.build_settings['FRAMEWORK_SEARCH_PATHS'] << ' "${PODS_ROOT}/../UnityLibrary"'
      end
    end
  end
end
