# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = '1'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  # Current Flutter CI actions export this directly. Newer Flutter SDKs no
  # longer guarantee that Generated.xcconfig contains FLUTTER_ROOT.
  environment_flutter_root = ENV['FLUTTER_ROOT']
  return environment_flutter_root unless environment_flutter_root.nil? || environment_flutter_root.empty?

  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "Generated.xcconfig must exist. If you're running pod install manually, make sure flutter pub get has been executed."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/\AFLUTTER_ROOT=(.*)\z/)
    return matches[1] if matches
  end
  raise "FLUTTER_ROOT not found in Generated.xcconfig. Try deleting Generated.xcconfig and running flutter pub get."
end

# Generated.xcconfig exposes FLUTTER_ROOT; podhelper supplies the Flutter
# CocoaPods integration methods used below. The export-environment script is
# not a Ruby file and must not be required by CocoaPods.
require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

install! 'cocoapods', :deterministic_uuids => false

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  legacy_unity_resource_bundles = %w[
    nanopb_nanopb.bundle
    leveldb_leveldb.bundle
    Promises_FBLPromises.bundle
    GoogleUtilities_GoogleUtilities-UserDefaults.bundle
    GoogleUtilities_GoogleUtilities-Reachability.bundle
  ]

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # Help the plugin find UnityFramework
    if target.name == 'flutter_unity_widget'
      target.build_configurations.each do |config|
        config.build_settings['FRAMEWORK_SEARCH_PATHS'] ||= '$(inherited)'
        config.build_settings['FRAMEWORK_SEARCH_PATHS'] << ' "${PODS_ROOT}/../UnityLibrary"'
      end

    end
  end

  # The checked-in Unity export still links Firebase through SPM. Its
  # transitive resource bundles are listed as inputs to Runner's CocoaPods
  # resource-copy phase, but the stale export does not materialize them.
  # Produce them in the consuming Runner target immediately before that copy;
  # an earlier dependency-target phase is not sufficient because SPM replaces
  # the dependency product directory later in the build.
  installer.aggregate_targets.flat_map(&:user_targets).uniq.each do |user_target|
    next unless user_target.name == 'Runner'

    phase = user_target.shell_script_build_phases.find do |candidate|
      candidate.name == 'Prepare Unity resource bundles'
    end || user_target.new_shell_script_build_phase('Prepare Unity resource bundles')
    phase.output_paths = legacy_unity_resource_bundles.map do |bundle|
      "$(BUILT_PRODUCTS_DIR)/flutter_unity_widget/#{bundle}"
    end
    phase.shell_script = <<-'SCRIPT'
set -e
destination="${BUILT_PRODUCTS_DIR}/flutter_unity_widget"
mkdir -p "${destination}"
for bundle in \
  nanopb_nanopb.bundle \
  leveldb_leveldb.bundle \
  Promises_FBLPromises.bundle \
  GoogleUtilities_GoogleUtilities-UserDefaults.bundle \
  GoogleUtilities_GoogleUtilities-Reachability.bundle; do
  bundle_path="${destination}/${bundle}"
  mkdir -p "${bundle_path}"
  printf '%s\n' 'Unused legacy Unity Firebase resource placeholder.' > "${bundle_path}/placeholder.txt"
done
SCRIPT

    # CocoaPods adds [CP] Copy Pods Resources after post_install returns.
    # Leave this producer at the end of the phases that already exist so the
    # subsequently generated consumer is ordered after it.
    user_target.build_phases.delete(phase)
    user_target.build_phases << phase
  end
end
